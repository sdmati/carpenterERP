generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1. Magazyn materiałów
model Material {
  id            Int    @id @default(autoincrement())
  name          String
  length        Float // Długość arkusza roboczego (np. 2800 mm)
  width         Float // Szerokość arkusza roboczego (np. 2070 mm)
  thickness     Float
  color         Color
  stockQuantity Int    @default(0) // Ilość całych arkuszy na stanie
  stockArea     Float  @default(0) // Powierzchnia w m2 do szybkiej weryfikacji

  parts PartDefinition[]
}

// 2. Definicja mebla (Katalog)
model Product {
  id     Int               @id @default(autoincrement())
  name   String
  parts  PartDefinition[]
  orders ProductionOrder[]
}

// 3. Składowe elementy mebla (Przepis technologiczny)
model PartDefinition {
  id        Int    @id @default(autoincrement())
  name      String // np. "Bok lewy"
  quantity  Int // ILE takich elementów jest w JEDNYM meblu (np. 2 sztuki)
  length    Float // Wymiar w mm
  width     Float // Wymiar w mm
  thickness Float

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  materialId Int
  material   Material @relation(fields: [materialId], references: [id])

  tasks ProductionTask[]
}

// 4. Maszyny na hali
model Machine {
  id    Int              @id @default(autoincrement())
  name  String // np. "Biesse Skipper 100", "Piła panelowa"
  type  MachineType // np. "DRILL", "SAW"
  tasks ProductionTask[]
}

// 5. Zlecenie wyprodukowania
model ProductionOrder {
  id       Int         @id @default(autoincrement())
  quantity Int // Ilość zamawianych mebli
  color    Color
  status   OrderStatus @default(PENDING)

  productId Int
  product   Product @relation(fields: [productId], references: [id])

  tasks ProductionTask[]
}

// 6. Partia produkcyjna / wózek technologiczny
model ProductionTask {
  id       Int        @id @default(autoincrement())
  quantity Int // Liczba formatek na palecie / w partii
  status   TaskStatus @default(PENDING)
  barcode  String?    @unique

  orderId Int
  order   ProductionOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  partDefId      Int
  partDefinition PartDefinition @relation(fields: [partDefId], references: [id])

  machineId Int?
  machine   Machine? @relation(fields: [machineId], references: [id])
}

enum OrderStatus {
  PENDING
  IN_PROGRESS
  PACKED
  COMPLETED
}

enum TaskStatus {
  PENDING
  CUT
  DRILLED
  COMPLETED
}

enum Color {
  SONOMA
  WHITE
  GRAY
  BLACK
}

generator erd {
  provider = "prisma-erd-generator"
  output   = "ERD.md"
}

enum Role {
  SAW_OPERATOR // Piła panelowa -> może CUT
  DRILL_OPERATOR // Centrum wiertarskie CNC -> może DRILLED
  PACKER // Pakownia -> może COMPLETED
  ADMIN // Kierownik - moze wszystko
}

enum MachineType {
  DRILL
  SAW
}

model User {
  id        Int    @id @default(autoincrement())
  username  String @unique
  password  String
  name      String
  role      Role
  machineId Int?
}
