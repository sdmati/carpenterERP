generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1. Magazyn materiałów
model Material {
  id            Int    @id @default(autoincrement())
  name          String
  length        Float // Długość arkusza roboczego (np. 2800 mm)
  width         Float // Szerokość arkusza roboczego (np. 2070 mm)
  thickness     Float
  color         Color
  stockQuantity Int    @default(0) // Ilość całych arkuszy na stanie
  stockArea     Float  @default(0) // Powierzchnia w m2 do szybkiej weryfikacji

  parts PartDefinition[]
}

// 2. Definicja mebla (Katalog)
model Product {
  id     Int               @id @default(autoincrement())
  name   String
  parts  PartDefinition[]
  orders ProductionOrder[]
}

// 3. Składowe elementy mebla (Przepis technologiczny)
model PartDefinition {
  id        Int    @id @default(autoincrement())
  name      String // np. "Bok lewy"
  quantity  Int // ILE takich elementów jest w JEDNYM meblu (np. 2 sztuki)
  length    Float // Wymiar w mm
  width     Float // Wymiar w mm
  thickness Float

  // Informacje o okleinowaniu (Edge banding)
  edgeLength1       Boolean @default(false) // 1. krawędź wzdłuż długości
  edgeLength2       Boolean @default(false) // 2. krawędź wzdłuż długości
  edgeWidth1        Boolean @default(false) // 1. krawędź wzdłuż szerokości
  edgeWidth2        Boolean @default(false) // 2. krawędź wzdłuż szerokości
  edgeTapeType      String? // np. "ABS", "PCV", "Melamina"
  edgeTapeColor     Color?  // Kolor okleiny (np. SONOMA, WHITE)
  edgeTapeThickness Float?  // Grubość okleiny w mm (np. 0.8, 1.0, 2.0)

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  materialId Int
  material   Material @relation(fields: [materialId], references: [id])

  tasks ProductionTask[]
}

// 4. Maszyny na hali
model Machine {
  id    Int              @id @default(autoincrement())
  name  String // np. "Biesse Skipper 100", "Piła panelowa"
  type  MachineType // np. "DRILL", "SAW"
  tasks ProductionTask[]
}

// 5. Zlecenie wyprodukowania
model ProductionOrder {
  id               Int         @id @default(autoincrement())
  quantity         Int // Ilość zamawianych mebli
  color            Color
  status           OrderStatus @default(PENDING)
  sheetsUsed       Int         @default(0) // Liczba zużytych arkuszy płyty wpisana przez pilarza
  edgeTapeDeducted Boolean     @default(false) // Czy okleina została już odliczona z magazynu

  productId Int
  product   Product @relation(fields: [productId], references: [id])

  tasks ProductionTask[]
}

// 6. Magazyn okleiny (Edge banding)
model EdgeTape {
  id          Int      @id @default(autoincrement())
  name        String   // np. "Okleina ABS Sonoma 1.0mm"
  type        String   // np. "ABS", "Melamina", "PCV"
  color       Color    // np. SONOMA, WHITE
  thickness   Float    // Grubość okleiny w mm (np. 0.8, 1.0, 2.0)
  width       Float?   // Szerokość taśmy w mm (np. 22 mm)
  stockMeters Float    @default(0) // Stan magazynowy w metrach bieżących (mb)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([type, color, thickness])
}

// 6. Partia produkcyjna / wózek technologiczny
model ProductionTask {
  id       Int        @id @default(autoincrement())
  quantity Int // Liczba formatek na palecie / w partii
  status   TaskStatus @default(PENDING)
  barcode  String?    @unique

  orderId Int
  order   ProductionOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  partDefId      Int
  partDefinition PartDefinition @relation(fields: [partDefId], references: [id])

  machineId Int?
  machine   Machine? @relation(fields: [machineId], references: [id])
}

enum OrderStatus {
  PENDING
  IN_PROGRESS
  PACKED
  COMPLETED
}

enum TaskStatus {
  PENDING
  CUT
  EDGED
  DRILLED
  COMPLETED
}

enum Color {
  SONOMA
  WHITE
  GRAY
  BLACK
}

generator erd {
  provider = "prisma-erd-generator"
  output   = "ERD.md"
}

enum Role {
  SAW_OPERATOR // Piła panelowa -> może CUT
  EDGE_BANDER_OPERATOR // Okleiniarka -> może EDGED
  DRILL_OPERATOR // Centrum wiertarskie CNC -> może DRILLED
  PACKER // Pakownia -> może COMPLETED / PACKED
  ADMIN // Kierownik - moze wszystko
}

enum MachineType {
  DRILL
  SAW
  EDGE_BANDER
}

model User {
  id        Int    @id @default(autoincrement())
  username  String @unique
  password  String
  name      String
  role      Role
  machineId Int?
}
